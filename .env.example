# Copy to .env and fill in what you need. Every setting is optional.

# Extras to run, comma-separated: tailscale, domain. Empty = just the app on HTTP_PORT.
COMPOSE_PROFILES=

# Where the app listens on this machine. On a public server use 127.0.0.1:8090,
# so it's only reachable through the domain or Tailscale, not as plain HTTP.
HTTP_PORT=8090

# Timezone of activity times, used for reminders.
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Moscow

# Telegram bot for login, notifications and reminders: token from @BotFather.
# Empty = Telegram features are off.
BOT_TOKEN=

# Public address of the site, added as a link to Telegram messages.
# e.g. https://plans.example.com or https://plany.<tailnet>.ts.net
SITE_URL=

# --- profile "domain" -------------------------------------------------------
# Your domain. Its DNS A/AAAA record must point to this server, ports 80 and 443 open.
# The HTTPS certificate is issued and renewed automatically.
DOMAIN=

# --- profile "tailscale" ----------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys (needed on first start only).
TS_AUTHKEY=
# Becomes the link https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=plany
